#!/usr/bin/env node
/*
 * direa-clr — die-a-rea adapter for .NET assemblies.
 *
 * Wraps an operator-supplied post-processor (e.g. ConfuserEx) via
 * `DIREA_CLR_COMMAND`, a shell command with `{artifact}` and `{out}`
 * placeholders. Bring your own toolchain (ADR-0007/0009).
 *
 * Example:
 *   export DIREA_CLR_ADAPTER=/path/to/adapters/clr/direa-clr
 *   export DIREA_CLR_COMMAND="Confuser.CLI -n {out}.crproj"
 *
 * Protocol: one JSON request on stdin, one JSON response on stdout (ADR-0002).
 */
'use strict';

const fs = require('fs');
const { execSync } = require('child_process');

function readStdin() {
  try {
    return fs.readFileSync(0, 'utf8');
  } catch (_) {
    return '';
  }
}
function emit(obj) {
  process.stdout.write(JSON.stringify(obj));
}

function main() {
  const adapter = 'clr';
  let req;
  try {
    req = JSON.parse(readStdin() || '{}');
  } catch (e) {
    emit({
      adapter,
      status: 'error',
      findings: [{ severity: 'error', code: 'bad_request', message: String(e) }],
      message: 'invalid JSON request',
    });
    return;
  }

  const op = req.op || 'plan';
  const build = process.env.DIREA_CLR_COMMAND;

  if (op === 'capabilities' || op === 'verify') {
    emit({
      adapter,
      status: build ? 'ok' : 'unavailable',
      steps: [],
      findings: [],
      metrics: { engine: build ? 'configured-command' : 'none' },
      message: build ? 'ready (DIREA_CLR_COMMAND set)' : 'set DIREA_CLR_COMMAND (e.g. ConfuserEx)',
    });
    return;
  }

  if (!build) {
    emit({
      adapter,
      status: 'unavailable',
      steps: [],
      findings: [],
      metrics: {},
      message: 'DIREA_CLR_COMMAND not set; .NET protection is bring-your-own',
    });
    return;
  }

  const out = (req.options && req.options.out) || '';
  const cmd = build
    .replace(/\{artifact\}/g, req.target || '')
    .replace(/\{out\}/g, out);

  if (op === 'plan') {
    emit({
      adapter,
      status: 'ok',
      steps: [{ adapter, action: 'protect', detail: cmd, external: true, destructive: true }],
      findings: [],
      metrics: {},
      message: 'would run the configured .NET protector',
    });
    return;
  }

  try {
    execSync(cmd, { stdio: 'inherit' });
    emit({
      adapter,
      status: 'ok',
      steps: [{ adapter, action: 'protect', detail: cmd, external: true, destructive: true }],
      findings: [],
      metrics: {},
      message: 'ran the configured .NET protector',
    });
  } catch (e) {
    emit({
      adapter,
      status: 'error',
      steps: [],
      findings: [{ severity: 'error', code: 'protect_failed', message: String(e.message || e) }],
      message: 'configured .NET protector failed',
    });
  }
}

main();
