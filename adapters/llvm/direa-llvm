#!/usr/bin/env node
/*
 * direa-llvm — die-a-rea adapter for LLVM-based obfuscation (Pluto-Obfuscator,
 * O-MVLL, obfuscator-llvm).
 *
 * LLVM obfuscation is a *compile-time* transform, so this adapter does not
 * rewrite a built binary. Instead it runs an operator-supplied build command
 * (your obfuscating clang/Pluto build) when `DIREA_LLVM_BUILD` is set, and
 * otherwise reports `unavailable`. Bring your own toolchain (ADR-0007/0009).
 *
 * Protocol: one JSON request on stdin, one JSON response on stdout (ADR-0002).
 * Configure the host with:
 *   export DIREA_LLVM_ADAPTER=/path/to/adapters/llvm/direa-llvm
 *   export DIREA_LLVM_BUILD="clang -mllvm -fla -mllvm -bcf -o {artifact} src/*.c"
 */
'use strict';

const fs = require('fs');
const { execSync } = require('child_process');

function readStdin() {
  try {
    return fs.readFileSync(0, 'utf8');
  } catch (_) {
    return '';
  }
}
function emit(obj) {
  process.stdout.write(JSON.stringify(obj));
}

function main() {
  const adapter = 'llvm';
  let req;
  try {
    req = JSON.parse(readStdin() || '{}');
  } catch (e) {
    emit({
      adapter,
      status: 'error',
      findings: [{ severity: 'error', code: 'bad_request', message: String(e) }],
      message: 'invalid JSON request',
    });
    return;
  }

  const op = req.op || 'plan';
  const build = process.env.DIREA_LLVM_BUILD;

  if (op === 'capabilities' || op === 'verify') {
    emit({
      adapter,
      status: build ? 'ok' : 'unavailable',
      steps: [],
      findings: [],
      metrics: { engine: build ? 'configured-build' : 'none' },
      message: build
        ? 'ready (DIREA_LLVM_BUILD set)'
        : 'set DIREA_LLVM_BUILD to an obfuscating build command (Pluto/O-MVLL)',
    });
    return;
  }

  if (!build) {
    emit({
      adapter,
      status: 'unavailable',
      steps: [],
      findings: [],
      metrics: {},
      message: 'DIREA_LLVM_BUILD not set; LLVM obfuscation is compile-time',
    });
    return;
  }

  const out = (req.options && req.options.out) || '';
  const cmd = build
    .replace(/\{artifact\}/g, req.target || '')
    .replace(/\{out\}/g, out);

  if (op === 'plan') {
    emit({
      adapter,
      status: 'ok',
      steps: [{ adapter, action: 'build', detail: cmd, external: true, destructive: true }],
      findings: [],
      metrics: {},
      message: 'would run the configured build',
    });
    return;
  }

  try {
    execSync(cmd, { stdio: 'inherit' });
    emit({
      adapter,
      status: 'ok',
      steps: [{ adapter, action: 'build', detail: cmd, external: true, destructive: true }],
      findings: [],
      metrics: {},
      message: 'ran the configured obfuscating build',
    });
  } catch (e) {
    emit({
      adapter,
      status: 'error',
      steps: [],
      findings: [{ severity: 'error', code: 'build_failed', message: String(e.message || e) }],
      message: 'configured build failed',
    });
  }
}

main();
